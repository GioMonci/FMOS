# Git ignore file for FMOS

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and temporary files (FMOS saves its own logs outside the repository)
*.log
logs/
temp/
tmp/

# Go build output
build/
/fmos
*.exe
*.test
*.out
