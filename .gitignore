# Git ignore file for FMOS

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/*
!logs/README.md
temp/
tmp/

# C++ and CMake build output
build/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.obj
*.o
*.exe
*.pdb
